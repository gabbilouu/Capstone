<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Pill shape -->
    <corners android:radius="20dp" />

    <!-- Fill color -->
    <solid android:color="#F9ECD5" />

    <!-- Outline -->
    <stroke
        android:width="1dp"
        android:color="#C3B19D" />

    <!-- Optional: extra inner spacing (chip feel) -->
    <padding
        android:left="8dp"
        android:top="4dp"
        android:right="8dp"
        android:bottom="4dp" />
</shape>
